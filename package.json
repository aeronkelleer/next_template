{
  "name": "next_template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run clean && concurrently \"next dev\" \"npm run watch:images\"",
    "clean": "node -e \"const fs = require('node:fs'); ['.next', 'tsconfig.tsbuildinfo'].forEach((path) => fs.rmSync(path, { recursive: true, force: true }))\"",
    "watch:images": "node scripts/watch-images.mjs",
    "generate:images": "node scripts/generate-images.mjs",
    "prebuild": "npm run clean && npm run generate:images",
    "build": "next build",
    "start": "next start",
    "lint": "npm run clean && eslint .",
    "lint:fix": "eslint . --fix"
  },
  "browserslist": [
    "last 5 chrome versions",
    "last 5 firefox versions",
    "last 5 safari versions",
    "not dead",
    "not ie 11"
  ],
  "dependencies": {
    "@reduxjs/toolkit": "2.12.0",
    "axios": "1.18.1",
    "clsx": "^2.1.1",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-redux": "9.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.2.10",
    "globals": "^17.7.0",
    "sass": "^1.101.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "8.64.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.11.1": true
  }
}